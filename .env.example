APP_NAME="Joy Portal Agent"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/joy-portal-agent/database/database.sqlite

# The Xray API must listen on loopback only. Never expose it publicly.
XRAY_BINARY=/usr/local/x-ui/bin/xray-linux-amd64
XRAY_API_ADDRESS=127.0.0.1:62789
XRAY_API_TIMEOUT=5
XRAY_STATS_PATTERN=user>>>
XRAY_COLLECTION_ENABLED=false
XRAY_USER_WRITES_ENABLED=false
XRAY_USER_RECONCILE_ENABLED=false

# Keep false during the validation phase. Resetting counters can lose data.
XRAY_RESET_AFTER_READ=false

# Central Joy usage synchronization (enable after credential mapping is ready).
JOY_USAGE_SYNC_ENABLED=false
JOY_USAGE_URL=https://app2.iclland.ir/api/internal/portal/usage
JOY_CREDENTIALS_URL=https://app2.iclland.ir/api/internal/portal/credentials/snapshot
JOY_RUNTIME_STATUS_URL=https://app2.iclland.ir/api/internal/portal/runtime/status
JOY_HEALTH_URL=https://app2.iclland.ir/api/internal/portal/health
JOY_CREDENTIAL_SYNC_ENABLED=false
JOY_NODE_ID=portal-br217
JOY_AGENT_ID=portal-1
JOY_AGENT_SECRET=
JOY_API_TIMEOUT=10
JOY_USAGE_BATCH_SIZE=200
XRAY_SESSION_IDLE_TIMEOUT=180
XRAY_ONLINE_STATUS_ENABLED=true
JOY_HEARTBEAT_INTERVAL=60
XRAY_HEALTH_ENABLED=true
XRAY_SERVICE_NAME=x-ui
XRAY_HEALTH_INTERVAL=30
XRAY_RESTART_COOLDOWN=60
XRAY_RESTART_WAIT=20
